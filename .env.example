# Copiez ce fichier vers .env.local : `cp .env.example .env.local`
#
# Toutes les valeurs NEXT_PUBLIC_* ci-dessous sont PUBLIQUES par conception :
# elles sont embarquées dans le bundle envoyé à chaque navigateur (elles
# figurent d'ailleurs déjà dans apphosting.yaml). Les valeurs par défaut
# pointent vers le projet de production, dont les règles Firestore n'autorisent
# que la lecture — le site fonctionne donc en local sans aucun credential.

# Firebase (config Web publique du projet "suiteadonner")
NEXT_PUBLIC_FIREBASE_API_KEY=AIzaSyAQrsqraRtDIT9Y2wdtUI1SssTz3TuO-ng
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=suiteadonner.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=suiteadonner
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=suiteadonner.firebasestorage.app
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=464378215335
NEXT_PUBLIC_FIREBASE_APP_ID=1:464378215335:web:8a9c4d906d54414b3a9482
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=G-RHQGYZ242D

# Algolia — recherche plein texte (voir src/lib/algolia.ts)
# App ID + clé Search (publique, lecture seule) : Algolia > Settings > API Keys
NEXT_PUBLIC_ALGOLIA_APP_ID=B8GIER7BSB
NEXT_PUBLIC_ALGOLIA_SEARCH_KEY=18f6c21f33f71338434d84df22622a80
NEXT_PUBLIC_ALGOLIA_INDEX_NAME=petitions

# Clé Admin Algolia (SECRÈTE, jamais NEXT_PUBLIC_, jamais commise) — utilisée
# uniquement par scripts/import-petitions.mjs pour écrire l'index. Réservée aux
# mainteneurs : laissez vide, la synchronisation est alors simplement ignorée.
ALGOLIA_ADMIN_KEY=
