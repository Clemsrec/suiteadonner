rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Données publiques (pétitions Assemblée nationale, open data) : lecture
    // libre, écriture réservée au script d'import (Admin SDK, hors règles).
    match /petitions/{petitionId} {
      allow read: if true;
      allow write: if false;
    }
    match /meta/{docId} {
      allow read: if true;
      allow write: if false;
    }
    // Recoupements thématiques pétition ↔ débats en séance, calculés hors ligne
    // par scripts/croiser-petitions-debats.mjs.
    match /recoupements/{petitionId} {
      allow read: if true;
      allow write: if false;
    }
    // Réunions de commission où une pétition figure à l'ordre du jour,
    // extraites par scripts/fetch-reunions.mjs.
    match /reunions/{petitionId} {
      allow read: if true;
      allow write: if false;
    }
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
